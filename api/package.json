{
  "name": "@wt/api-contract",
  "private": true,
  "type": "module",
  "scripts": {
    "beff": "beff -p beff.json",
    "check": "tsc --project tsconfig.json && prettier --check api.ts parser.ts generate-rust.mjs beff.json tsconfig.json package.json",
    "generate": "npm run beff && node --experimental-strip-types generate-rust.mjs"
  },
  "dependencies": {
    "@beff/client": "0.0.152"
  },
  "devDependencies": {
    "@beff/cli": "0.0.152"
  }
}

#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
"$root/scripts/require-clean-checkout"

if ! command -v cargo >/dev/null; then
    echo "Rust stable via rustup is required" >&2
    exit 1
fi

cd "$root"
scripts/cargo install --locked --force --path crates/products/wt/client

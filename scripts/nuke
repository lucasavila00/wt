#!/usr/bin/env bash
set -euo pipefail

report_failure() {
    status=$?
    if (( status != 0 )); then
        printf '\nERROR: server cleanup stopped before completion (exit status %d).\n' "$status" >&2
    fi
}
trap report_failure EXIT

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

if [[ $# -ne 0 ]]; then
    echo "usage: scripts/nuke" >&2
    exit 2
fi
if [[ $EUID -eq 0 ]]; then
    echo "run this script as the server user, not with sudo" >&2
    exit 1
fi
if [[ ! -t 0 ]]; then
    echo "run this script in an interactive terminal; sudo authentication is required" >&2
    exit 1
fi

sudo systemctl disable --now wts.service 2>/dev/null || true

mapfile -t domains < <(virsh -c qemu:///system list --all --name | awk '/^wt-/{print}')
for domain in "${domains[@]}"; do
    state=$(virsh -c qemu:///system domstate "$domain")
    if [[ $state != "shut off" ]]; then
        virsh -c qemu:///system destroy "$domain"
    fi
    virsh -c qemu:///system undefine "$domain" --nvram
done

sudo rm -f /etc/systemd/system/wts.service \
    /etc/systemd/system/wt-agent-tool-gateway.service \
    /etc/systemd/system/wt-codex-integration-auth.service \
    /etc/systemd/system/wt-codex-integration-auth.path \
    /etc/systemd/system/wt-ssh-authorized-keys.service \
    /etc/systemd/system/wt-ssh-authorized-keys.path \
    /usr/local/libexec/wt-codex-integration-auth-share \
    /usr/local/libexec/wt-ssh-authorized-keys-share
sudo rm -f \
    /etc/credstore.encrypted/wts-github-api-token \
    /etc/credstore.encrypted/wts-github-ssh-private-key \
    /etc/credstore.encrypted/wts-gitlab-api-token \
    /etc/credstore.encrypted/wts-gitlab-ssh-private-key \
    /etc/credstore.encrypted/wt-agent-tool-gateway-github-api-token \
    /etc/credstore.encrypted/wt-agent-tool-gateway-github-ssh-private-key \
    /etc/credstore.encrypted/wt-agent-tool-gateway-github-ssh-known-hosts \
    /etc/credstore.encrypted/wt-agent-tool-gateway-gitlab-api-token \
    /etc/credstore.encrypted/wt-agent-tool-gateway-gitlab-ssh-private-key \
    /etc/credstore.encrypted/wt-agent-tool-gateway-gitlab-ssh-known-hosts
rm -f "$HOME/.codex/sessions/.wt-image-publication-probe"
rm -rf "$root/imgs" "$HOME/.local/state/wt" "$HOME/.ssh/wt" "$HOME/.wt"
rm -rf "$HOME/.codex/.wt-auth"
rm -rf "$HOME/.ssh/.wt-authorized-keys"
sudo systemctl daemon-reload
sudo rm -rf /etc/wt /var/lib/wt/images /var/lib/wt/agent-tools \
    /var/lib/libvirt/images/wt \
    /run/wt-image-build

#!/usr/bin/env bash
set -euo pipefail

report_failure() {
    status=$?
    if (( status != 0 )); then
        printf '\nERROR: server cleanup stopped before completion (exit status %d).\n' "$status" >&2
    fi
}
trap report_failure EXIT

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

if [[ $# -ne 0 ]]; then
    echo "usage: scripts/nuke" >&2
    exit 2
fi
if [[ $EUID -eq 0 ]]; then
    echo "run this script as the server user, not with sudo" >&2
    exit 1
fi
if [[ ! -t 0 ]]; then
    echo "run this script in an interactive terminal; sudo authentication is required" >&2
    exit 1
fi

sudo systemctl disable --now wt-server.service wt-agent-git-gateway.service \
    wt-codex-integration-auth.path wt-codex-auth.path 2>/dev/null || true

mapfile -t domains < <(virsh -c qemu:///system list --all --name | awk '/^wt-/{print}')
for domain in "${domains[@]}"; do
    state=$(virsh -c qemu:///system domstate "$domain")
    if [[ $state != "shut off" ]]; then
        virsh -c qemu:///system destroy "$domain"
    fi
    virsh -c qemu:///system undefine "$domain" --nvram
done

if command -v docker >/dev/null; then
    docker rm -f wt-workload-registry-cache wt-registry-cache 2>/dev/null || true
fi

sudo rm -f /etc/systemd/system/wt-server.service \
    /etc/systemd/system/wt-agent-git-gateway.service \
    /etc/systemd/system/wt-codex-integration-auth.service \
    /etc/systemd/system/wt-codex-integration-auth.path \
    /usr/local/libexec/wt-codex-integration-auth-share \
    /etc/systemd/system/wt-codex-auth.service \
    /etc/systemd/system/wt-codex-auth.path \
    /usr/local/libexec/wt-codex-auth-share
sudo rm -f \
    /etc/credstore.encrypted/wt-agent-git-gateway-github-api-token \
    /etc/credstore.encrypted/wt-agent-git-gateway-github-ssh-private-key \
    /etc/credstore.encrypted/wt-agent-git-gateway-github-ssh-known-hosts \
    /etc/credstore.encrypted/wt-agent-git-gateway-gitlab-api-token \
    /etc/credstore.encrypted/wt-agent-git-gateway-gitlab-ssh-private-key \
    /etc/credstore.encrypted/wt-agent-git-gateway-gitlab-ssh-known-hosts \
    /etc/credstore.encrypted/wt-agent-git-github-api-token \
    /etc/credstore.encrypted/wt-agent-git-github-ssh-private-key \
    /etc/credstore.encrypted/wt-agent-git-github-ssh-known-hosts \
    /etc/credstore.encrypted/wt-agent-git-gitlab-api-token \
    /etc/credstore.encrypted/wt-agent-git-gitlab-ssh-private-key \
    /etc/credstore.encrypted/wt-agent-git-gitlab-ssh-known-hosts
rm -rf "$root/imgs" "$HOME/.local/state/wt" "$HOME/.ssh/wt" "$HOME/.wt"
rm -rf "$HOME/.codex/.wt-auth"
sudo rm -f /etc/systemd/system/docker.service.d/wt-workload-registry-cache.conf \
    /etc/systemd/system/docker.service.d/wt-registry-cache.conf
sudo rm -f /usr/local/share/ca-certificates/wt-workload-registry-cache.crt \
    /usr/local/share/ca-certificates/wt-registry-cache.crt
sudo systemctl daemon-reload
if systemctl list-unit-files docker.service >/dev/null 2>&1; then
    sudo systemctl restart docker.service
fi
sudo update-ca-certificates
sudo rm -rf /etc/wt /var/lib/wt/images /var/lib/wt/agent-git \
    /var/lib/wt/registry-cache /var/lib/libvirt/images/wt \
    /run/wt-image-build

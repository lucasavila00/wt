#!/usr/bin/env bash
set -euo pipefail

report_failure() {
    status=$?
    if (( status != 0 )); then
        printf '\nERROR: WT state cleanup stopped before completion (exit status %d).\n' "$status" >&2
    fi
}
trap report_failure EXIT

if [[ $# -ne 0 ]]; then
    echo "usage: scripts/clear" >&2
    exit 2
fi
if [[ $EUID -eq 0 ]]; then
    echo "run this script as the server user, not with sudo" >&2
    exit 1
fi
if [[ ! -t 0 ]]; then
    echo "run this script in an interactive terminal; sudo authentication is required" >&2
    exit 1
fi

sudo systemctl stop wt-server.service wt-agent-tool-gateway.service 2>/dev/null || true

mapfile -t domains < <(virsh -c qemu:///system list --all --name | awk '/^wt-/{print}')
for domain in "${domains[@]}"; do
    state=$(virsh -c qemu:///system domstate "$domain")
    if [[ $state != "shut off" ]]; then
        virsh -c qemu:///system destroy "$domain"
    fi
    virsh -c qemu:///system undefine "$domain" --nvram
done

rm -f "$HOME/.codex/sessions/.wt-image-publication-probe"
rm -rf "$HOME/.local/state/wt" "$HOME/.ssh/wt"
sudo rm -rf /etc/wt /var/lib/wt/agent-tools /var/lib/libvirt/images/wt
kvm_gid=$(getent group kvm | cut -d: -f3)
if [[ -z $kvm_gid ]]; then
    echo "kvm group not found" >&2
    exit 1
fi
sudo install -d -o "$EUID" -g "$kvm_gid" -m 2770 /var/lib/libvirt/images/wt
sudo setfacl -m u:libvirt-qemu:--x -- /var/lib/libvirt/images/wt

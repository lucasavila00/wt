#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"

if [[ -n $(git status --porcelain=v1 --untracked-files=all) ]]; then
    echo "installation requires a clean Git checkout at a known commit" >&2
    echo "commit or remove these changes before installing:" >&2
    git status --short --untracked-files=all >&2
    exit 1
fi

git rev-parse --verify HEAD >/dev/null

---
source: crates/products/wt/server-installer/src/install_input.rs
expression: text
---
version = 1
test_server = false

[image]
path = "/var/lib/wt/images/retained.qcow2"

[libvirt]
network = "default"
worlds_dir = "/var/lib/libvirt/images/wt"

[agent_tools]
vsock_port = 18017

[agent_tools.github]
host = "github.com"

[guest]
boot_timeout_seconds = 300
readiness_timeout_seconds = 900

[install]
binary_dir = "/usr/local/bin"

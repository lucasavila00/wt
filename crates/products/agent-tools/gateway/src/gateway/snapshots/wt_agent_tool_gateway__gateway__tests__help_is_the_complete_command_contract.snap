---
source: crates/products/agent-tools/gateway/src/gateway.rs
expression: wt_tools_help()
---
wtg tools reads and changes explicitly identified Git provider resources and sends
messages to the controller responsible for this world. It accepts exactly one JSON
command object and rejects unknown fields.

USAGE:
wtg tools '<JSON>'
wtg tools --file PATH
wtg tools --stdin
wtg tools -

`--file PATH` reads one UTF-8 JSON command from a file. `--file -`, `--stdin`, and
`-` read one UTF-8 JSON command from standard input until end-of-file.

TYPESCRIPT COMMAND TYPE:
    /** State transition accepted by the set_mr command. */
    export type ChangeRequestState = "ready" | "draft" | "open" | "closed";

    /** Explicit Git hosting provider and repository. */
    export type GitHostingTarget = {
      provider: "github" | "gitlab";
      repository: string;
    };

    /** Command sent to a Git hosting provider. */
    export type GitHostingCommand =
      | { action: "show_mr"; mr: string }
      | { action: "show_mr_for_branch"; branch: string }
      | { action: "show_run"; run: string }
      | { action: "show_job"; job: string }
      | { action: "list_threads"; mr: string }
      | { action: "list_comments"; mr: string }
      | { action: "show_comment"; mr: string; comment: string }
      | {
          action: "edit_comment";
          mr: string;
          comment: string;
          body: string;
          confirm_merged?: boolean;
        }
      | {
          action: "delete_comment";
          mr: string;
          comment: string;
          confirm_merged?: boolean;
        }
      | { action: "list_ci"; commit: string }
      | { action: "list_jobs"; run: string }
      | { action: "log_job"; job: string }
      | { action: "wait_mr"; mr: string; timeout_seconds?: number }
      | { action: "wait_run"; run: string; timeout_seconds?: number }
      | { action: "wait_job"; job: string; timeout_seconds?: number }
      | { action: "open_mr"; head: string; base: string }
      | { action: "set_mr"; mr: string; state: ChangeRequestState; confirm_merged?: boolean }
      | { action: "edit_mr"; mr: string; title?: string; body?: string; confirm_merged?: boolean }
      | { action: "comment_mr"; mr: string; body: string; confirm_merged?: boolean }
      | { action: "reply_thread"; mr: string; thread: string; body: string; confirm_merged?: boolean }
      | {
          action: "set_thread";
          mr: string;
          thread: string;
          resolved: boolean;
          confirm_merged?: boolean;
        }
      | { action: "retry_job"; job: string }
      | { action: "cancel_job"; job: string }
      | { action: "cancel_run"; run: string };

    /** Untargeted message to the controller responsible for this world. */
    export type WtToolsWorldCommand = { action: "send_message_to_parent"; message: string };

    /** One JSON command accepted by wt-tools. */
    export type WtToolsCommand =
      | { target: GitHostingTarget; command: GitHostingCommand }
      | { command: WtToolsWorldCommand };

EXAMPLE:
wtg tools '{"target":{"provider":"github","repository":"acme/widget"},"command":{"action":"show_mr_for_branch","branch":"wt/fix-login"}}'
wtg tools --file command.json
printf '%s\n' '{"command":{"action":"send_message_to_parent","message":"example"}}' | wtg tools -

`show_mr_for_branch` returns the single open MR from the named branch in the target
repository. It fails when there is no match or multiple matches.

`send_message_to_parent` omits `target` and commits durable mail from the caller's
managed Byobu window without contacting the Git provider.

Provider operations return one JSON result or error object. Help remains
plain text.

The target selects one installer-configured provider and an explicit repository.
IDs must be positive integers. Commit values must be 7 to
64 hexadecimal characters. Use normal Git for commits, fetches, pulls, and pushes.

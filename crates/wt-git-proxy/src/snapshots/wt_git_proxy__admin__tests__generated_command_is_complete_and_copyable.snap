---
source: crates/wt-git-proxy/src/admin.rs
expression: command
---
umask 077; d="$HOME/.ssh/wt-git-proxy/wt-git-abc123"; g="$HOME/.ssh/wt-git-proxy/gitconfig"; install -d "$d"; printf '%s' 'UFJJVkFURSBLRVkK' | base64 -d > "$d/id_ed25519"; printf '%s' 'cHJveHkuZXhhbXBsZS5jb20gc3NoLWVkMjU1MTkgSE9TVEtFWQo=' | base64 -d > "$d/known_hosts"; printf '%s' '' | base64 -d > "$d/config"; printf '%s' 'W3VybCAid3QtZ2l0LWFiYzEyMzpnaXRodWIuY29tLyJdCiAgaW5zdGVhZE9mID0gaHR0cHM6Ly9naXRodWIuY29tLwogIGluc3RlYWRPZiA9IGdpdEBnaXRodWIuY29tOgogIGluc3RlYWRPZiA9IHNzaDovL2dpdEBnaXRodWIuY29tLwo=' | base64 -d > "$g"; touch "$HOME/.ssh/config"; chmod 600 "$HOME/.ssh/config"; grep -qxF 'Include ~/.ssh/wt-git-proxy/*/config' "$HOME/.ssh/config" || printf '\nInclude ~/.ssh/wt-git-proxy/*/config\n' >> "$HOME/.ssh/config"; git config --global --get-all include.path 2>/dev/null | grep -qxF "$g" || git config --global --add include.path "$g"
